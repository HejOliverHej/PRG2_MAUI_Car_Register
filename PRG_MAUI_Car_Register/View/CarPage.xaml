<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PRG_MAUI_Car_Register.View.CarPage"
             xmlns:viewModel="clr-namespace:PRG_MAUI_Car_Register.ViewModel"
             Title="CarPage">




    <ContentPage.BindingContext>
        <viewModel:VehicleViewModel SelectedPage="Bil" />
    </ContentPage.BindingContext>

    
        <HorizontalStackLayout HorizontalOptions="Center" Margin="0,0,0,20" Spacing="10">

            <ListView ItemsSource="{Binding FilteredVehicles}" Margin="0,0,0,20">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextCell Text="{Binding RegistrationNumber}" Detail="{Binding Manufacturer}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </HorizontalStackLayout>
</ContentPage>